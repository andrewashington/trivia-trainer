generator client {
  provider      = "prisma-client-js"
  // "native" for local dev (macOS/Linux); the musl+openssl3 target is
  // what the Alpine-based production container needs. Without this the
  // generated client lacks the right query-engine binary and crashes
  // on boot ("could not locate the Query Engine for linux-musl-openssl-3.0.x").
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  admin
}

enum RsvpStatus {
  going
  maybe
  no
}

enum MediaType {
  show
  movie
  book
}

enum PlayStatus {
  active
  finished
}

// The User table doubles as the allowlist: only emails present here may
// sign in. Admins add members by creating rows (see /api/admin/members).
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  displayName   String
  avatarUrl     String? // rendered DiceBear URL — denormalized from avatarConfig for the render path
  avatarConfig  Json? // structured Open Peeps choices (seed + pinned features); source of truth for the builder
  role          Role      @default(member)
  discordUserId String?   @unique // reserved for phase 2 (Discord bot), unused in v1
  venmoHandle   String? // payments stay person-to-person — we just link to Venmo
  emailVerified DateTime? // managed by Auth.js
  icalToken     String    @unique @default(cuid())
  onboardedAt   DateTime? // null until the first-login wizard is finished
  coins         Int       @default(0) // denormalized balance; CoinTransaction is the ledger
  introsSeen    String[]  @default([]) // module keys whose intro card was dismissed
  moduleSeenAt  Json? // { [moduleKey]: ISO } — last time the user opened each module, for unread badges
  lastSeenAt    DateTime? // heartbeat from the app shell — powers the "who's online" header widget
  createdAt     DateTime  @default(now())

  accounts           Account[]
  sessions           Session[]
  recipes            Recipe[]
  events             Event[]
  rsvps              Rsvp[]
  playing            NowPlayingItem[]
  files              FileObject[]
  vaultEntries       VaultEntry[]
  contactCard        ContactCard?
  wishlistItems      WishlistItem[]
  coolFinds          CoolFind[]
  mapPins            MapPin[]
  ideas              Idea[]
  ideaVotes          IdeaVote[]
  listings           Listing[]          @relation("listings")
  claims             Listing[]          @relation("claims")
  polls              Poll[]
  pollVotes          PollVote[]
  revealPrompts      RevealPrompt[]
  revealSubmissions  RevealSubmission[]
  claimsCreated      Claim[]            @relation("claimsCreated")
  claimsAgainst      Claim[]            @relation("claimsAgainst")
  petNudges          PetNudge[]
  pollRevealVotes    PollRevealVote[]
  revealUnlockVotes  RevealUnlockVote[]
  feedback           Feedback[]
  arcadeScores       ArcadeScore[]
  countdowns         Countdown[]
  tanksChallenges    TanksGame[]        @relation("tanksChallenger")
  tanksDefenses      TanksGame[]        @relation("tanksOpponent")
  tanksWins          TanksGame[]        @relation("tanksWinner")
  tanksTurns         TanksTurn[]
  coinTransactions   CoinTransaction[]
  coinRewardClaims   CoinRewardClaim[]
  gameChatMessages   GameChatMessage[]
  gayReadings        GayReading[]
  photobookPhotos    PhotobookPhoto[]
  photobookTags      PhotobookTag[]
  blackjackHands     BlackjackHand[]
  challenges         Challenge[]
  challengeEntries   ChallengeEntry[]
  challengeVotes     ChallengeVote[]
  tierLists          TierList[]
  tierPlacements     TierPlacement[]
  keyCard            KeySubmission?
  comments           Comment[]
  treasureDigs       TreasureDig[]
  treasureFinds      TreasureDay[]      @relation("treasureFinds")
  canvasStrokes      CanvasStroke[]
  smashDecks         SmashDeck[]
  smashVotes         SmashVote[]
  notifications      Notification[]     @relation("UserNotifications")
  notificationsActed Notification[]     @relation("ActorNotifications")
  arcadeRounds       ArcadeRound[]
  minesGames         MinesGame[]
  crashRounds        CrashRound[]
  worldOwnedItems    WorldOwnedItem[]
  worldCosmetics     WorldOwnedCosmetic[]
  worldHouse         WorldHouse?
  worldAvatar        WorldAvatar?
  pokerSeats         PokerSeat[]
  tqHosted           TwentyQuestionsGame[]  @relation("tqHost")
  tqWon              TwentyQuestionsGame[]  @relation("tqWinner")
  tqEntries          TwentyQuestionsEntry[] @relation("tqAsker")
}

// ============ Blackjack: casino hands wagering coins ============

// Server-authoritative: the shuffled shoe + both hands live in `state`
// (JSON: { deck, player, dealer } of card codes like "AS"), so the client
// never sees the hole card or the next draw. One active hand per user.
// status: active | won | lost | push | blackjack. payout = coins credited
// back on resolution (0 on a loss). Splits intentionally unsupported.
model BlackjackHand {
  id         String    @id @default(cuid())
  userId     String
  bet        Int
  doubled    Boolean   @default(false)
  state      Json
  status     String    @default("active")
  payout     Int       @default(0)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

// --- Tiermaker: group tier lists ---
// One list, shared items, per-user placements. Consensus is computed
// live (S=0..F=5, averaged) — never stored.

model TierList {
  id          String   @id @default(cuid())
  creatorId   String
  title       String
  description String?
  sensitive   Boolean  @default(false)
  createdAt   DateTime @default(now())

  creator    User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  items      TierItem[]
  placements TierPlacement[]
}

model TierItem {
  id       String @id @default(cuid())
  listId   String
  label    String
  position Int    @default(0)

  list       TierList        @relation(fields: [listId], references: [id], onDelete: Cascade)
  placements TierPlacement[]

  @@index([listId])
}

model TierPlacement {
  id        String   @id @default(cuid())
  listId    String
  itemId    String
  userId    String
  tier      String // "S" | "A" | "B" | "C" | "D" | "F"
  position  Int      @default(0)
  updatedAt DateTime @updatedAt

  list TierList @relation(fields: [listId], references: [id], onDelete: Cascade)
  item TierItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([listId, userId])
}

// --- How Gay?: one deterministic reading per user per day ---
// percent = hash(userId + date) — the row just records that you checked,
// so the same-day leaderboard knows who's shown up.

model GayReading {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD (server-local day)
  percent   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// ============ Coins: the household currency ============

// Append-only ledger; User.coins is kept in sync in the same transaction.
// `reason` is the outbox event type that earned the coins.
model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reason, createdAt])
}

// Claim records for app-wide free coin drops. The active campaign lives in
// src/lib/coinRewards.ts; this table makes each reward idempotent per user.
model CoinRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  rewardKey String
  amount    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardKey])
  @@index([rewardKey, createdAt])
}

// ============ Tanks: async turn-based artillery duels ============

// A match is fully described by its seed + ordered turns (the engine in
// modules/tanks replays them deterministically). hp/status/currentPlayer
// are denormalized here so the lobby and the home "needs you" strip can
// query without replaying physics.
model TanksGame {
  id              String    @id @default(cuid())
  seed            Int
  challengerId    String
  opponentId      String
  currentPlayerId String
  status          String    @default("active") // "active" | "finished"
  winnerId        String?
  challengerHp    Int       @default(100)
  opponentHp      Int       @default(100)
  turnCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  finishedAt      DateTime?

  challenger User        @relation("tanksChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User        @relation("tanksOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  winner     User?       @relation("tanksWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  turns      TanksTurn[]

  @@index([status, updatedAt])
  @@index([currentPlayerId, status])
}

// One fired shot. Immutable; the engine derives everything else.
model TanksTurn {
  id        String   @id @default(cuid())
  gameId    String
  playerId  String
  index     Int // 0-based turn number within the game
  weapon    String // "shell" | "bigone" | "triple"
  angle     Float // degrees, 0 = right, 180 = left
  power     Float // 10..100
  createdAt DateTime @default(now())

  game   TanksGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player User      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, index])
}

// Smack talk + crowd chat alongside a game. Generic by design: `channel`
// scopes a conversation (e.g. "tanks:<gameId>") so other games can reuse
// the same table and API without new migrations.
model GameChatMessage {
  id        String   @id @default(cuid())
  channel   String // "<game>:<id>", e.g. "tanks:cmq..."
  userId    String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channel, createdAt])
}

// A thing the group is counting down to. Past countdowns linger in a
// "landed" section for 7 days (query-time filter), then are hidden —
// never deleted, so the row survives for the activity feed.
model Countdown {
  id        String   @id @default(cuid())
  creatorId String
  title     String
  emoji     String?
  targetAt  DateTime
  link      String?
  createdAt DateTime @default(now())

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([targetAt])
}

// One row per finished run of an arcade game. We keep every run (not
// just a personal best) so the leaderboard can show recent activity and
// the pet can feed on plays; "personal best" is just a max() at query
// time, mirroring how Stakes computes its accuracy board on the fly.
model ArcadeScore {
  id        String   @id @default(cuid())
  userId    String
  game      String // which arcade game, e.g. "snake" — room for more later
  score     Int
  // Lightweight run stats for flavor on the board (longest combo, etc.).
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([game, score])
  @@index([game, userId, score])
}

model Recipe {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  body      String   @db.Text // freeform markdown
  imageKey  String? // object-storage key, single image
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Event {
  id          String    @id @default(cuid())
  creatorId   String
  title       String
  description String?   @db.Text
  location    String?
  startAt     DateTime
  endAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps   Rsvp[]

  @@index([startAt])
}

model Rsvp {
  eventId   String
  userId    String
  status    RsvpStatus
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

model NowPlayingItem {
  id          String     @id @default(cuid())
  userId      String
  mediaType   MediaType
  title       String
  note        String?
  status      PlayStatus @default(active)
  rating      Int? // 1-5, asked for when the item is marked finished
  // TMDB metadata, attached when the title was picked from search.
  // All optional — free-typed entries (books, anything) have none.
  tmdbId      Int?
  posterPath  String? // e.g. "/abc123.jpg" — prepend image.tmdb.org/t/p/<size>
  releaseYear Int?
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model FileObject {
  id         String   @id @default(cuid())
  uploaderId String
  filename   String
  mimeType   String // images + pdf only (validated server-side)
  sizeBytes  Int
  storageKey String
  sensitive  Boolean  @default(false)
  createdAt  DateTime @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  photobookPhoto PhotobookPhoto?
  challengeEntry ChallengeEntry?

  @@index([createdAt])
}

// ============ Photobook: pics of the group together ============

// A gallery entry wrapping an image FileObject. Tags record which
// members appear in the shot.
model PhotobookPhoto {
  id         String   @id @default(cuid())
  uploaderId String
  fileId     String   @unique
  caption    String?
  sensitive  Boolean  @default(false)
  createdAt  DateTime @default(now())

  uploader User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  file     FileObject     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tags     PhotobookTag[]

  @@index([createdAt])
}

model PhotobookTag {
  photoId String
  userId  String

  photo PhotobookPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([photoId, userId])
  @@index([userId])
}

// Domain-event outbox. Nothing consumes it in v1; the phase-2 Discord
// worker will poll rows where processedAt IS NULL. Rows must be written
// in the same transaction as the change they describe (see lib/outbox).
model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt, createdAt])
}

// Shared site logins. The password is AES-256-GCM encrypted at rest
// (see lib/crypto) and is NEVER included in list responses or outbox
// payloads — it's fetched one entry at a time via the reveal endpoint.
model VaultEntry {
  id          String   @id @default(cuid())
  creatorId   String
  siteName    String
  siteUrl     String?
  username    String
  passwordEnc String // iv:tag:ciphertext, base64
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([siteName])
}

// One contact card per member, self-maintained (admin can edit any).
model ContactCard {
  userId    String    @id
  phone     String?
  email     String? // a preferred contact email, if different from login
  birthday  DateTime? @db.Date
  address   String?   @db.Text
  notes     String?   @db.Text
  updatedAt DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedParties RelatedParty[]
}

// Spouse / partner / emergency contact attached to a member's card.
model RelatedParty {
  id       String  @id @default(cuid())
  cardId   String
  name     String
  relation String? // "spouse", "partner", "mom", …
  phone    String?
  email    String?

  card ContactCard @relation(fields: [cardId], references: [userId], onDelete: Cascade)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String?
  imageUrl  String? // og:image scraped from the link, if any
  siteName  String? // og:site_name scraped from the link, if any
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// "Cool Finds" — shared useful/funny/interesting links, a tab in the wishlist.
model CoolFind {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String
  category  String   @default("interesting") // tools | funny | interesting | other
  note      String?
  imageUrl  String? // og:image scraped from the link, if any
  siteName  String? // og:site_name scraped from the link, if any
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category, createdAt])
}

enum PinCategory {
  food
  drink
  outdoors
  fun
  home
  other
}

// The group atlas: favorite restaurants, the good taco truck, trip pins.
model MapPin {
  id        String      @id @default(cuid())
  creatorId String
  name      String
  category  PinCategory @default(other)
  lat       Float
  lng       Float
  address   String?
  note      String?
  createdAt DateTime    @default(now())

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

enum IdeaStatus {
  open
  planned
  done
}

enum DeliveryMethod {
  pickup
  delivery
  either
}

enum ListingStatus {
  available
  claimed
  gone
}

// The group garage sale. Claiming is first-come-first-served and
// atomic (see the claim route) so two people can't "get" the toaster.
// Money changes hands on Venmo, not here.
model Listing {
  id          String         @id @default(cuid())
  sellerId    String
  title       String
  description String?        @db.Text
  priceCents  Int? // null = free
  delivery    DeliveryMethod @default(pickup)
  imageKey    String?
  status      ListingStatus  @default(available)
  claimedById String?
  claimedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  seller    User  @relation("listings", fields: [sellerId], references: [id], onDelete: Cascade)
  claimedBy User? @relation("claims", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// The suggestion box: anything the group should do, buy, build, or try.
model Idea {
  id        String     @id @default(cuid())
  authorId  String
  title     String
  detail    String?    @db.Text
  status    IdeaStatus @default(open)
  createdAt DateTime   @default(now())

  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  IdeaVote[]

  @@index([status, createdAt])
}

model IdeaVote {
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideaId, userId])
}

enum PollType {
  single // pick one
  multi // pick any
  scale // rate 1–5
}

// Single-question polls. `anonymous` is fixed at creation: votes are
// always stored with a userId (one ballot per member, changeable while
// open) but anonymous polls never expose who voted for what — not in
// the API responses and not in outbox payloads.
model Poll {
  id              String    @id @default(cuid())
  creatorId       String
  question        String
  type            PollType  @default(single)
  anonymous       Boolean   @default(false)
  sensitive       Boolean   @default(false)
  closedAt        DateTime?
  // Sealed results: hidden until this many members vote to reveal them.
  revealThreshold Int?
  createdAt       DateTime  @default(now())

  creator     User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  options     PollOption[]
  votes       PollVote[]
  revealVotes PollRevealVote[]

  @@index([createdAt])
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  order  Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, order])
}

// One row per (user, option) for choice polls; one row with `rating`
// for scale polls. A re-vote replaces all of the user's rows for the
// poll in one transaction.
model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  optionId  String?
  rating    Int?
  createdAt DateTime @default(now())

  poll   Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  option PollOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId, userId])
}

// "Show us the results" ballots for sealed-result polls. One per
// member per poll; counts toward Poll.revealThreshold.
model PollRevealVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

// ============ The Reveal: submit blind, reveal together ============

enum RevealType {
  rank // everyone privately ranks a list; consensus revealed
  sealed // a note locked until a date — hidden from EVERYONE, author included
}

enum RevealStatus {
  open
  revealed
}

model RevealPrompt {
  id                String       @id @default(cuid())
  creatorId         String
  type              RevealType
  title             String
  items             Json? // rank: the labels being ranked, fixed at creation
  deadline          DateTime? // rank: reveal at deadline if enough submitted
  unlockAt          DateTime? // sealed: auto-open date
  minSubmitters     Int          @default(3) // rank: floor so answers can't be reverse-engineered
  // sealed: optional early-unseal — opens when this many members vote for it
  unlockVotesNeeded Int?
  status            RevealStatus @default(open)
  revealedAt        DateTime?
  createdAt         DateTime     @default(now())

  creator     User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  submissions RevealSubmission[]
  unlockVotes RevealUnlockVote[]

  @@index([status, createdAt])
}

// Hidden payloads. Never returned to other members raw — reveals expose
// only computed aggregates (and a sealed note's body after unlockAt).
model RevealSubmission {
  id        String   @id @default(cuid())
  promptId  String
  userId    String
  payload   Json // rank: {order:number[]} · sealed: {body:string}
  createdAt DateTime @default(now())

  prompt RevealPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promptId, userId])
}

// Early-unseal ballots for sealed prompts. One per member per prompt;
// counts toward RevealPrompt.unlockVotesNeeded.
model RevealUnlockVote {
  id        String   @id @default(cuid())
  promptId  String
  userId    String
  createdAt DateTime @default(now())

  prompt RevealPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promptId, userId])
}

// ============ Stakes: claim → lock → resolve ============

enum ClaimOutcome {
  right
  wrong
  void
}

// A prediction, optionally with a counterparty and a favor at stake.
// Immutable once created ("locked"); only status/outcome ever change.
// Stakes are favors and chores, never money — money lives in Market.
model Claim {
  id             String        @id @default(cuid())
  creatorId      String
  text           String
  resolvesAt     DateTime
  hidden         Boolean       @default(false) // conceal text until resolved (solo predictions only)
  counterpartyId String?
  stake          String? // "loser buys coffee"
  outcome        ClaimOutcome?
  resolvedAt     DateTime?
  resolvedById   String? // null on a resolved sports claim = the oracle ruled
  settledAt      DateTime? // favor delivered
  createdAt      DateTime      @default(now())
  // Sports mode: tied to a real fixture, auto-settled from the final score.
  fixtureId      String?
  pickTeam       String? // exact home/away team name the creator backs

  creator      User     @relation("claimsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  counterparty User?    @relation("claimsAgainst", fields: [counterpartyId], references: [id], onDelete: SetNull)
  fixture      Fixture? @relation(fields: [fixtureId], references: [id], onDelete: SetNull)

  @@index([resolvedAt, resolvesAt])
}

// A real-world game cached from TheSportsDB. Scores are written once at
// settlement so a bet's outcome is anchored to what we recorded, not a
// re-fetch that might later change.
model Fixture {
  id        String   @id // TheSportsDB idEvent
  league    String
  homeTeam  String
  awayTeam  String
  startsAt  DateTime
  homeScore Int?
  awayScore Int?
  finished  Boolean  @default(false)
  fetchedAt DateTime @default(now())

  claims Claim[]
}

// ============ The Pet: derived state, zero required input ============

// The only stored pet data: its name. Mood is computed live from the
// outbox (the app-wide activity stream) — see modules/pet/engine.
model PetState {
  id        Int      @id @default(1)
  name      String   @default("Wiggle")
  updatedAt DateTime @updatedAt
}

// The one optional input: a daily pat. Everything else is derived.
model PetNudge {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum FeedbackKind {
  bug
  idea
  praise
}

enum FeedbackSeverity {
  low
  medium
  high
}

// In-app feedback so testers can report bugs / wishes without leaving
// the app. Admins triage these on the Admin page.
model Feedback {
  id         String           @id @default(cuid())
  userId     String
  path       String // the page they were on
  kind       FeedbackKind     @default(bug)
  severity   FeedbackSeverity @default(medium) // only meaningful for bugs
  message    String           @db.Text
  userAgent  String?
  context    Json? // auto-captured client context (viewport, locale, tz, etc.) for triage
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
}

// --- Discord bot: account linking ---
// `/link` in Discord mints a short code; entering it on /me (signed in)
// sets User.discordUserId. Codes are single-use and short-lived.

model DiscordLinkCode {
  code            String   @id
  discordUserId   String
  discordUsername String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([discordUserId])
}

// --- Auth.js (NextAuth) support models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// World character look. Config = chosen generator parts (bodies/eyes/
// hairstyles/outfits, store-bought extras later); the composited personal
// spritesheet lives at world/avatars/<userId>.png in S3 (or the local
// runtime dir in dev). Separate from User.avatarConfig (site avatar).
model WorldAvatar {
  id        String   @id @default(cuid())
  userId    String   @unique
  config    Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ Challenges: throw down, submit proof, vote a winner ============

// A dare for the group: photo contests, scavenger finds, sneaky pics.
// Open until its deadline passes or the creator closes it. Settlement
// (picking the winner + paying coins) is idempotent via settledAt:
// manual close settles immediately; deadline-passed challenges settle
// lazily on first view.
model Challenge {
  id            String    @id @default(cuid())
  creatorId     String
  title         String
  description   String?   @db.Text
  deadline      DateTime?
  closedAt      DateTime? // creator/admin closed it manually
  settledAt     DateTime? // winner computed + coins paid (idempotence guard)
  winnerEntryId String?   @unique
  createdAt     DateTime  @default(now())

  creator     User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  entries     ChallengeEntry[]
  votes       ChallengeVote[]
  winnerEntry ChallengeEntry?  @relation("challengeWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// One entry per member per challenge: text proof and/or a photo.
model ChallengeEntry {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  text        String?  @db.Text
  fileId      String?  @unique
  createdAt   DateTime @default(now())

  challenge    Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  file         FileObject?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  votes        ChallengeVote[]
  wonChallenge Challenge?      @relation("challengeWinner")

  @@unique([challengeId, userId])
}

// One changeable vote per member per challenge; self-votes rejected
// server-side.
model ChallengeVote {
  challengeId String
  voterId     String
  entryId     String
  createdAt   DateTime @default(now())

  challenge Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  voter     User           @relation(fields: [voterId], references: [id], onDelete: Cascade)
  entry     ChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([challengeId, voterId])
  @@index([entryId])
}

// ============ The Key: the hidden anatomy quiz ============

// One self-reported card per member. Sensitive at rest: every trait is
// optional, answers stay concealed unless visibility="group", and other
// members only ever see rows that opted in. The archetype is computed
// server-side — never accepted from the client.
model KeySubmission {
  id             String   @id @default(cuid())
  userId         String   @unique
  unitPreference String   @default("imperial") // display only; storage is mm
  lengthMm       Int? // canonical millimetres; null = prefer not to say
  girthMm        Int?
  glansShape     String?
  shaftProfile   String?
  foreskinStatus String?
  pubicHair      String?
  veinVisibility String?
  curveVertical  String?
  curveLateral   String?
  curveIntensity String?
  visibility     String   @default("concealed") // "concealed" | "group"
  archetypeId    String?
  archetypeLabel String?
  archetypeBlurb String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ Comments: one thread on anything ============

// Polymorphic by (targetType, targetId): polls, ideas, events — and any
// future surface — share one table and one thread component. No FK to the
// target on purpose; routes validate the target exists before insert.
model Comment {
  id         String   @id @default(cuid())
  targetType String // "poll" | "idea" | "event"
  targetId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
}

// ============ Buried Treasure: one dig a day ============

// One row per UTC day, created lazily on first view/dig. The pot rolls
// over: a new day absorbs the most recent unfound day's pot (+500 base),
// so a cold streak builds a jackpot.
model TreasureDay {
  day       String    @id // YYYY-MM-DD (UTC)
  x         Int // treasure cell, 0-9 — never sent to the client until found
  y         Int
  pot       Int
  foundById String?
  foundAt   DateTime?

  foundBy User?         @relation("treasureFinds", fields: [foundById], references: [id], onDelete: SetNull)
  digs    TreasureDig[]
}

model TreasureDig {
  id        String   @id @default(cuid())
  day       String
  userId    String
  x         Int
  y         Int
  found     Boolean  @default(false)
  createdAt DateTime @default(now())

  treasureDay TreasureDay @relation(fields: [day], references: [day], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One free dig per person per day; extra digs cost coins (route-enforced),
  // so no unique constraint here.
  @@index([day, userId])
  @@index([day])
}

// ============ Infinite Canvas: the group doodle wall ============

// Append-only by design — there is no erase. Each row is one stroke (or
// one stamped emoji) in world coordinates; the client pans/zooms forever
// and replays strokes in order. Nothing is ever updated or deleted.
model CanvasStroke {
  id        String   @id @default(cuid())
  userId    String
  tool      String   @default("pen") // "pen" | "marker" | "highlighter" | "stamp"
  color     String
  size      Int
  points    Json // [[x, y], ...] world coords; stamps use a single point
  stamp     String? // emoji glyph when tool = "stamp"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// ============ Smash or Pass: the people deserve to judge ============

model SmashDeck {
  id        String   @id @default(cuid())
  creatorId String
  title     String
  detail    String?
  createdAt DateTime @default(now())

  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  cards   SmashCard[]
}

model SmashCard {
  id         String  @id @default(cuid())
  deckId     String
  label      String
  imageUrl   String? // external link, mutually exclusive with storageKey
  storageKey String? // uploaded image in the S3 bucket (same flow as photobook)
  position   Int     @default(0)

  deck  SmashDeck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  votes SmashVote[]

  @@index([deckId])
}

model SmashVote {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  verdict   String // "smash" | "pass"
  createdAt DateTime @default(now())

  card SmashCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId]) // one verdict per person per card
}

// ============ Notifications: tell owners when someone comments ============

model Notification {
  id         String    @id @default(cuid())
  userId     String // recipient
  type       String // "comment" for now; extensible
  actorId    String? // who triggered it
  targetType String?
  targetId   String?
  title      String
  body       String?
  href       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

// ============ Arcade coin games (Limbo / Mines / Crash) ============
// Append-only audit log of every settled coin-game round, for auditing
// and leaderboards. Coin movement itself rides the CoinTransaction ledger
// (stake debited on play, winnings credited on win) in the same tx.
model ArcadeRound {
  id         String   @id @default(cuid())
  userId     String
  game       String // "limbo" | "mines" | "crash"
  stake      Int
  multiplier Float // realized payout multiplier (0 on a loss)
  outcome    String // "win" | "loss"
  net        Int // winnings - stake (negative on a loss)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([game, net])
  @@index([game, multiplier])
  @@index([userId, createdAt])
}

// In-flight Mines round. `mines` (the bomb layout) is server-only and must
// never be serialized to the client until the round is over.
model MinesGame {
  id         String    @id @default(cuid())
  userId     String
  stake      Int
  mineCount  Int
  mines      Int[] // tile indices 0..24 holding a mine — SERVER SECRET
  revealed   Int[]     @default([]) // safe tiles revealed so far
  status     String    @default("active") // "active" | "busted" | "cashed"
  multiplier Float     @default(1) // current banked multiplier on the revealed tiles
  createdAt  DateTime  @default(now())
  settledAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// In-flight Crash round. `crashPoint` is server-only until the round ends.
model CrashRound {
  id                String    @id @default(cuid())
  userId            String
  stake             Int
  crashPoint        Float // multiplier at which it busts — SERVER SECRET
  status            String    @default("active") // "active" | "cashed" | "busted"
  cashoutMultiplier Float? // multiplier banked if cashed out
  startedAt         DateTime  @default(now())
  settledAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ============ The World: decorative game world / coin sink ============
// Design doc: docs/world-design.md. Catalog rows are drafted in bulk by
// scripts/world-ingest.ts from the LimeZu packs, then curated (priced,
// published) in the /world/admin UI. Sprites live in packed atlases on S3;
// spriteKey = "<atlasKey>#<frameName>" into world/atlas/<atlasKey>.{png,json}.

model WorldItem {
  id        String   @id @default(cuid())
  key       String   @unique // stable slug from pack path, e.g. "mi-bathroom-bathtub-1"
  name      String // human name, editable in admin
  category  String // functional shop grouping, defaults to theme, editable
  theme     String? // pack theme folder slug, e.g. "living-room" — automatic, stable
  tier      String? // price tier (trinket|decor|furniture|statement|absurd); drives default price
  variantGroup String? // shared slug across colorways/materials of one object — shop shows one entry
  variant   String? // this variant's distinguishing label, e.g. "Oak" / "Sage" (null = no variants)
  tagline   String? // ironic one-line shop flavor copy
  tags      String[] @default([]) // freeform keywords (material/color/style/vibe) for search + filtering
  price     Int      @default(0) // 0 = unpriced draft; tier-derived or admin override
  spriteKey String // "<atlasKey>#<frameName>" — frameName is the stable item key
  tileW     Int      @default(1) // footprint in 16px tiles
  tileH     Int      @default(1)
  surface   String   @default("floor") // floor | wall | tabletop
  availability String @default("shop") // shop | unobtainable — unobtainable items never sell, but can still be granted/owned/placed
  published Boolean  @default(false) // appears in-game/catalog; shop also requires availability="shop" + price>0
  createdAt DateTime @default(now())

  ownedItems WorldOwnedItem[]

  @@index([published, availability, category])
  @@index([theme])
  @@index([variantGroup])
  @@index([tags], type: Gin)
}

// Inventory; placement lives on the row (null x/y = in storage, not placed)
model WorldOwnedItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  x         Int?
  y         Int?
  rotation  Int      @default(0)
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item WorldItem @relation(fields: [itemId], references: [id])

  @@index([userId])
}

// Generic world game-data overrides, keyed JSON documents edited in
// /world/admin. Code ships defaults; getWorldContent() merges these on
// top. Keys today: "cosmetics" (price/name overrides), "dialog" (NPC
// lines). Future tunables get new keys, not new tables.
model WorldConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// App-wide keyed JSON config, edited in /admin. Same shape as WorldConfig
// but not world-namespaced: home for Discord-feed toggles, per-game tuning
// knobs, promo-campaign overrides, and future feature flags. Code ships the
// defaults; a row here overrides them, so admin edits take effect live.
model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Unlocked avatar cosmetics. Catalog (names/prices/colors) lives in
// src/modules/world/cosmetics.ts; this row just records ownership.
// kind = "outfit" today; future kinds (hairstyle…) reuse the table.
model WorldOwnedCosmetic {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  itemKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, itemKey])
}

// One house per user; tier = floorplan size (the big coin sink), plot =
// which neighborhood door is theirs (matches "plot-N-door" spawns in the map)
model WorldHouse {
  id        String   @id @default(cuid())
  userId    String   @unique
  tier      Int      @default(1)
  plot      Int      @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ Poker: ongoing async Texas Hold'em cash tables ============
//
// Zero-sum vs. the table — no coins are minted or burned by play. Coins
// move from a player's balance into their `PokerSeat.stack` when they sit,
// ride the pot between seat stacks during a hand, and return to the balance
// when they stand up. The deck and hole cards are server-only secrets (in
// JSON) until showdown. There is no live socket: turns are async with a
// per-action deadline, and the engine lazily auto-acts (check/fold) for a
// player whose clock expired whenever anyone next loads the hand.

model PokerTable {
  id          String      @id @default(cuid())
  name        String
  smallBlind  Int         @default(1)
  bigBlind    Int         @default(2)
  // Per-action clock in hours: 1 | 6 | 24. How long a player has to act
  // before the engine auto-checks/folds them on the next poll.
  clockHours  Int         @default(24)
  status      String      @default("open") // "open" | "closed"
  createdById String
  createdAt   DateTime    @default(now())

  seats PokerSeat[]
  hands PokerHand[]

  @@index([status, createdAt])
}

// A player parked at a table. `stack` is real coins held off-balance while
// seated. One seat per user per table; seatIndex fixes turn order.
model PokerSeat {
  id         String   @id @default(cuid())
  tableId    String
  userId     String
  seatIndex  Int
  stack      Int
  sittingOut Boolean  @default(false)
  joinedAt   DateTime @default(now())

  table PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tableId, userId])
  @@unique([tableId, seatIndex])
  @@index([tableId])
}

// One dealt hand. `deck` (remaining stock) and per-seat hole cards are
// server secrets; `board` is the community cards revealed so far. `state`
// holds the live betting machine (street, currentBet, minRaise, toAct,
// deadline) plus the resolved result once complete.
model PokerHand {
  id          String    @id @default(cuid())
  tableId     String
  handNumber  Int
  buttonSeat  Int
  deck        Json      // int[] of remaining card codes — SECRET
  board       Json      @default("[]") // revealed community cards
  pot         Int       @default(0)
  state       Json      // betting state machine + result
  status      String    @default("betting") // "betting" | "complete"
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  table PokerTable      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seats PokerHandSeat[]
  actions PokerAction[]

  @@unique([tableId, handNumber])
  @@index([tableId, status])
}

// A seat's involvement in one hand. `hole` is that player's two cards —
// only ever sent to that user. Commit counters drive pot/side-pot math.
model PokerHandSeat {
  id             String  @id @default(cuid())
  handId         String
  seatIndex      Int
  userId         String
  hole           Json    // [cardA, cardB] — SECRET to others
  startingStack  Int
  committed      Int     @default(0) // total chips put in this hand
  streetCommit   Int     @default(0) // chips in on the current street
  folded         Boolean @default(false)
  allIn          Boolean @default(false)

  hand PokerHand @relation(fields: [handId], references: [id], onDelete: Cascade)

  @@unique([handId, seatIndex])
  @@index([handId])
}

// Append-only action log for a hand (audit + replay).
model PokerAction {
  id        String   @id @default(cuid())
  handId    String
  seatIndex Int
  userId    String
  street    String   // "preflop" | "flop" | "turn" | "river"
  kind      String   // "blind" | "fold" | "check" | "call" | "bet" | "raise"
  amount    Int      @default(0)
  createdAt DateTime @default(now())

  hand PokerHand @relation(fields: [handId], references: [id], onDelete: Cascade)

  @@index([handId, createdAt])
}

// ============ 20 Questions: async group guessing game ============
//
// A host picks a secret answer + category; everyone else submits yes/no
// questions into a shared pool. The host answers them (yes | no | sometimes)
// — up to 20 answered questions. Anyone may submit a guess; the host marks
// one correct to end the round, and the first correct guesser wins. Async +
// polling, like Tanks. `secret` stays hidden until the game ends.

model TwentyQuestionsGame {
  id          String    @id @default(cuid())
  hostId      String
  category    String    // "person" | "place" | "thing"
  secret      String    // SECRET until solved/revealed
  status      String    @default("active") // "active" | "solved" | "revealed"
  winnerId    String?
  answered    Int       @default(0) // count of answered questions (cap 20)
  createdAt   DateTime  @default(now())
  endedAt     DateTime?

  host    User    @relation("tqHost", fields: [hostId], references: [id], onDelete: Cascade)
  winner  User?   @relation("tqWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  entries TwentyQuestionsEntry[]

  @@index([status, createdAt])
}

// A question or a guess against a game. For questions, `answer` is null
// until the host responds. For guesses, `correct` is set when the host
// judges it (a correct guess ends the game).
model TwentyQuestionsEntry {
  id        String   @id @default(cuid())
  gameId    String
  askerId   String
  kind      String   // "question" | "guess"
  text      String
  answer    String?  // "yes" | "no" | "sometimes" — questions only
  correct   Boolean? // guesses only
  createdAt DateTime @default(now())

  game  TwentyQuestionsGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  asker User                @relation("tqAsker", fields: [askerId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
}

// ── Discord expansion (additive) ─────────────────────────────────────────────
// All Discord-expansion tables use a bare `userId String` (no relation to User)
// so the User model stays a conflict-free hotspot. See docs/discord-build-spec.md.

// Live-editable posted messages (poll cards, leaderboards, drops, games) so a
// card can be edited in place after the underlying entity changes.
model DiscordMessageRef {
  id        String   @id @default(cuid())
  kind      String // "poll" | "listing" | "leaderboard" | "drop" | "coinflip" | "digest"
  refId     String // the entity id this message mirrors
  channelId String
  messageId String
  createdAt DateTime @default(now())

  @@unique([kind, refId])
  @@index([messageId])
}

// Per-user DM notification opt-ins + cached DM channel.
model DiscordNotifyPref {
  userId      String   @id
  dmTurn      Boolean  @default(true) // your turn (Tanks/20Q/Poker)
  dmClaims    Boolean  @default(true) // outbid / claimed
  dmStakes    Boolean  @default(true) // stake resolving soon
  dmMentions  Boolean  @default(true) // comment reply / @mention
  dmDigest    Boolean  @default(false) // periodic digest
  digestDaily Boolean  @default(false) // true=daily, false=weekly
  dmChannelId String? // cached DM channel id
  updatedAt   DateTime @updatedAt
}

// AI Concierge: a pending draft awaiting the user's "Post it".
model DiscordDraft {
  id        String    @id @default(cuid())
  userId    String
  kind      String // "poll" | "idea" | "event" | "recipe" | "wishlist" | "countdown" | "listing" | "stake"
  data      Json // validated draft fields for that kind
  channelId String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  postedAt  DateTime?

  @@index([userId, createdAt]) // also used for the per-user daily AI cap
}

// In-chat coin drop: first-come or split among N claimers.
model DiscordDrop {
  id        String   @id @default(cuid())
  channelId String
  messageId String?
  amount    Int
  kind      String   @default("first") // "first" | "split"
  maxClaims Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())

  claims DiscordDropClaim[]
}

model DiscordDropClaim {
  dropId String
  userId String
  at     DateTime @default(now())

  drop DiscordDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@id([dropId, userId])
}

// Coinflip duel (zero-sum, winner takes both antes).
model DiscordCoinflip {
  id           String   @id @default(cuid())
  channelId    String
  messageId    String?
  challengerId String
  opponentId   String? // null = open challenge
  ante         Int
  status       String   @default("open") // open | settled | cancelled | expired
  winnerId     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

/// Durable facts the assistant has been told to remember ("VIII's real name is
/// Scott"). Loaded into the assistant's context so it can enhance answers.
model DiscordMemory {
  id            String   @id @default(cuid())
  fact          String // self-contained statement to remember
  subject       String? // optional free-text subject/tag (e.g. "VIII", "andre", "cabin")
  subjectUserId String? // optional UDM+ user the fact is about
  createdById   String // who taught it
  active        Boolean  @default(true) // soft-deletable via "forget"
  createdAt     DateTime @default(now())

  @@index([active, createdAt])
}

/// One assistant exchange (user message + reply) per channel, so the assistant
/// has reliable multi-turn memory independent of Discord's channel history.
model DiscordTurn {
  id            String   @id @default(cuid())
  channelId     String
  userId        String
  userText      String
  assistantText String
  createdAt     DateTime @default(now())

  @@index([channelId, createdAt])
}
