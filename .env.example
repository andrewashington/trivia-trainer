# --- Core ---
DATABASE_URL="postgresql://udm:udm@localhost:5432/udmplus"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# --- First-run admin (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_NAME="The Owner"

# --- Magic-link email delivery ---
# Option A: Resend (preferred). Just set the API key.
RESEND_API_KEY=""
EMAIL_FROM="UDM+ <login@yourdomain.com>"
# Option B: generic SMTP (used when RESEND_API_KEY is empty).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Object storage (S3-compatible: Cloudflare R2 / Backblaze B2 / MinIO) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="udmplus"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Set "true" for MinIO / some self-hosted stores.
S3_FORCE_PATH_STYLE="true"

# --- Files module ---
MAX_FILE_SIZE_MB="25"

# --- Vault module ---
# Key for encrypting shared passwords at rest (any long random string).
# Falls back to AUTH_SECRET if unset — but set it, so rotating one
# doesn't break the other.
VAULT_KEY=""

# --- Discord ---
# Legacy one-way feed: a channel webhook URL (Channel Settings →
# Integrations → Webhooks). Used only when the bot vars below are unset.
DISCORD_WEBHOOK_URL=""
# Full bot integration (discord.com/developers/applications):
# App ID + public key from General Information, token from the Bot tab,
# channel ID via right-click → Copy Channel ID (developer mode on).
# After setting these: npm run discord:register, then paste
# <AUTH_URL>/api/discord/interactions as the Interactions Endpoint URL.
DISCORD_APP_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
# Guild (server) ID — register slash commands to this guild for instant
# propagation (vs ~1h global); also used for native Scheduled Events.
DISCORD_GUILD_ID=""

# --- UDM AI assistant (/udm + @mention) ---
# OpenRouter powers the natural-language assistant. Reuse the same key as the
# world build scripts. Model defaults to a cheap/fast one; override if you like.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-haiku-4-5"

# --- Discord gateway sidecar (services/discord-gateway) ---
# The @mention listener forwards mentions to the app over a shared HMAC secret.
# Set the SAME DISCORD_GATEWAY_SECRET on the app and the sidecar. The sidecar
# also needs DISCORD_BOT_TOKEN, DISCORD_APP_ID, DISCORD_GUILD_ID, and
# APP_FORWARD_URL = <AUTH_URL>/api/discord/gateway. Enable the Message Content
# privileged intent in the dev portal for the sidecar.
DISCORD_GATEWAY_SECRET=""
APP_FORWARD_URL=""

# --- Map module ---
# NO API KEY NEEDED by default: tiles come from openstreetmap.org and
# geocoding from Nominatim (both free; fine at friend-group scale).
# If you ever want prettier tiles or heavier usage, get a free-tier key
# from MapTiler (maptiler.com) or Stadia Maps (stadiamaps.com) and set:
# NEXT_PUBLIC_MAP_TILE_URL="https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY"

# --- Now Playing: TMDB search + posters ---
# Either a TMDB v4 read access token (the long JWT, recommended) or a v3
# API key — both work. Free at themoviedb.org/settings/api. Optional:
# without it, Now Playing search/posters are hidden and manual entry
# works exactly as before.
TMDB_API_KEY=""
