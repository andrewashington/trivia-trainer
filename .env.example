# --- Core ---
DATABASE_URL="postgresql://udm:udm@localhost:5432/udmplus"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# --- First-run admin (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_NAME="The Owner"

# --- Magic-link email delivery ---
# Option A: Resend (preferred). Just set the API key.
RESEND_API_KEY=""
EMAIL_FROM="UDM+ <login@yourdomain.com>"
# Option B: generic SMTP (used when RESEND_API_KEY is empty).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Object storage (S3-compatible: Cloudflare R2 / Backblaze B2 / MinIO) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="udmplus"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Set "true" for MinIO / some self-hosted stores.
S3_FORCE_PATH_STYLE="true"

# --- Files module ---
MAX_FILE_SIZE_MB="25"
